# ============================================================
# E:\LLM 总仓库 —— 管理三个 MCP / 工具项目
# 规则按「文件类型」全局匹配，因此对三个子目录同时生效
# ============================================================

# ---------- Python 虚拟环境（体积大，且可由 pip 重装）----------
.venv/
venv/
env/
ENV/

# ---------- Python 缓存与构建产物 ----------
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
*.whl

# ---------- 密钥与本地配置（最重要的防线）----------
# 三个项目里的 .env 一律不进仓库。
# AnythingLLMCP/.env 存有 AnythingLLM 的 Developer API Key。
.env
.env.*
!.env.example
*.env
secrets.json
credentials.json

# Agent/Practice01/config.ini 存有 DeepSeek API Key，也绝不提交。
# 这里的写法不带路径，因此任何子目录下的 config.ini 都会被忽略。
config.ini

# ---------- 测试与覆盖率 ----------
.pytest_cache/
.coverage
htmlcov/
.tox/
.mypy_cache/
.ruff_cache/

# ---------- 编辑器 ----------
.vscode/
.idea/
*.swp
*.swo

# ---------- 操作系统 ----------
.DS_Store
Thumbs.db
desktop.ini

# ---------- 日志与临时文件 ----------
*.log
tmp/
temp/

# ---------- xiaoA：技能与测试产物只留本地，不进仓库 ----------
# 技能是各机器本地的工作区内容（SKILL.md/脚本），不同步
Agent/xiaoA/.agents/skills/*
# 测试运行时生成的 Word 文档等产物
Agent/xiaoA/*.docx

# ---------- xiaoA：上下文归档（会话本地数据，含完整对话，不同步）----------
.agents/context/

# 修正：归档目录可能出现在 Agent/xiaoA 子路径下
**/.agents/context/
**/.agents/sessions/
