# AnythingLLM 本机实例
ANYTHINGLLM_BASE_URL=http://localhost:3001

# AnythingLLM 桌面版 → Settings → Tools → Developer API 里生成
ANYTHINGLLM_API_KEY=

# 留空 = 自动使用唯一的工作区；有多个工作区时必须填 slug
ANYTHINGLLM_WORKSPACE=

# query = 只依据工作区文档回答（推荐）；chat = 允许模型掺入通用知识
ANYTHINGLLM_MODE=query

# MCP 服务监听地址（仅本机）
MCP_HOST=127.0.0.1
MCP_PORT=8765
MCP_PATH=/mcp

# 等待 AnythingLLM 回答的超时秒数（本地模型可能较慢）
REQUEST_TIMEOUT=120
